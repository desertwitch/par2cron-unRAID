# Copyright macester (parts of code from NUT package)
# Copyright gfjardim (parts of code from NUT package)
# Copyright SimonF (parts of code from NUT package)
# Copyright Lime Technology (any and all other parts of Unraid)
#
# Copyright desertwitch (as author and maintainer of this file)
#
# This program is free software; you can redistribute it and/or
# modify it under the terms of the GNU General Public License 2
# as published by the Free Software Foundation.
#
# The above copyright notice and this permission notice shall be
# included in all copies or substantial portions of the Software.
#
umask 000

NOTIFY_BIN="/usr/local/emhttp/plugins/dynamix/scripts/notify"
HOST=$(echo "$HOSTNAME" | awk '{print toupper($0)}')
EVENT="par2cron"
SUBJECT="[${HOST}] par2cron:"

TOTAL_STARTED=0
TOTAL_SUCCESS=0
TOTAL_FAILED=0
CREATE_STARTED=0
CREATE_SUCCESS=0
CREATE_FAILED=0
VERIFY_STARTED=0
VERIFY_SUCCESS=0
VERIFY_FAILED=0
VERIFY_CORRUPTED=0
REPAIR_STARTED=0
REPAIR_SUCCESS=0
REPAIR_FAILED=0

if pgrep -x par2cron &>/dev/null; then
    echo "par2cron is already running; exiting" | logger -s -t "par2cron-cron"
    exit 0
fi

if [ ! -r "/boot/config/plugins/dwpar2cron/dwpar2cron.cfg" ]; then
    echo "configuration file cannot be read; exiting" | logger -s -t "par2cron-cron"
    exit 0
fi

# shellcheck disable=SC1091
source "/boot/config/plugins/dwpar2cron/dwpar2cron.cfg"
IFS='|' read -ra OPSCOPE_ARRAY <<< "${OPSCOPE:-/mnt/user}"

if [[ "$CRON" != "hourly" && "$CRON" != "daily" && "$CRON" != "weekly" && "$CRON" != "monthly" ]]; then
    exit 0
fi

if ! mountpoint -q /mnt/user; then
    echo "array is not started; exiting" | logger -s -t "par2cron-cron"
    exit 0
fi

if [ "$MOVERSTART" != "enable" ] && [ -e "/var/run/mover.pid" ]; then
    echo "mover is running; exiting" | logger -s -t "par2cron-cron"
    [ "$STARTNOTIFY" == "enable" ] && "$NOTIFY_BIN" -e "${EVENT}" -s "Notice ${SUBJECT} Skipped" -d "Schedule was skipped (mover is running)." -i "warning"
    exit 0
fi

if [ "$PARITYSTART" != "enable" ] && [ -r "/var/local/emhttp/var.ini" ]; then
    PARITYPOS=$(grep "mdResyncPos=" < /var/local/emhttp/var.ini | cut -d'"' -f2)
    if [ -n "$PARITYPOS" ] && [ "$PARITYPOS" -gt 0 ]; then
        echo "parity operation is running; exiting" | logger -s -t "par2cron-cron"
        [ "$STARTNOTIFY" == "enable" ] && "$NOTIFY_BIN" -e "${EVENT}" -s "Notice ${SUBJECT} Skipped" -d "Schedule was skipped (parity operation in progress)." -i "warning"
        exit 0
    fi
fi

rm -f /var/log/dwpar2cron.log
rm -f /var/log/dwpar2cron.json

if [ "$CRONCREATE" == "enable" ]; then
    echo "create: started" | logger -s -t "par2cron-cron"

    if [ "$STARTNOTIFY" == "enable" ]; then
        "$NOTIFY_BIN" -e "${EVENT}" -s "Notice ${SUBJECT} Create: Started" -d "Creation has started according to schedule." -i "warning"
    fi

    /usr/bin/par2cron create \
        -c /boot/config/plugins/dwpar2cron/config.yaml \
        --json \
        "${OPSCOPE_ARRAY[@]}" \
        >> /var/log/dwpar2cron.log \
        2> >(tee -a /var/log/dwpar2cron.json >> /var/log/dwpar2cron.log 2>&1)
    RET=$?

    sleep 3
    sync

    CREATE_STARTED=$(grep -c '"msg":"Job started"' /var/log/dwpar2cron.json 2>/dev/null)
    CREATE_SUCCESS=$(grep -c '"msg":"Job completed with success"' /var/log/dwpar2cron.json 2>/dev/null)
    CREATE_FAILED=$(grep -c '"msg":"Job failure (will retry next run)"' /var/log/dwpar2cron.json 2>/dev/null)

    case "$RET" in
    0)
        echo "create: finished (return code: $RET - success) ($CREATE_STARTED started, $CREATE_SUCCESS created, $CREATE_FAILED failed)" | logger -s -t "par2cron-cron"
        if [ "$CREATE_STARTED" -gt 0 ] || [ "$ZERONOTIFY" == "enable" ]; then
            [ "$SUCCESSNOTIFY" == "enable" ] && "$NOTIFY_BIN" -e "${EVENT}" -s "Notice ${SUBJECT} Create: Success" -d "Creation has finished with success ($CREATE_STARTED started, $CREATE_SUCCESS created, $CREATE_FAILED failed)." -i "normal"
        fi
        ;;
    1)
        echo "create: finished (return code: $RET - partial failure) ($CREATE_STARTED started, $CREATE_SUCCESS created, $CREATE_FAILED failed)" | logger -s -t "par2cron-cron"
        [ "$ERRORNOTIFY" == "enable" ] && "$NOTIFY_BIN" -e "${EVENT}" -s "Alert ${SUBJECT} Create: Partial Failure" -d "Not all jobs could be created ($CREATE_STARTED started, $CREATE_SUCCESS created, $CREATE_FAILED failed)." -i "alert"
        ;;
    2)
        echo "create: finished (return code: $RET - bad invocation) ($CREATE_STARTED started, $CREATE_SUCCESS created, $CREATE_FAILED failed)" | logger -s -t "par2cron-cron"
        [ "$ERRORNOTIFY" == "enable" ] && "$NOTIFY_BIN" -e "${EVENT}" -s "Alert ${SUBJECT} Create: Bad Invocation" -d "A bad invocation error was returned ($CREATE_STARTED started, $CREATE_SUCCESS created, $CREATE_FAILED failed)." -i "alert"
        ;;
    5)
        echo "create: finished (return code: $RET - unclassified error) ($CREATE_STARTED started, $CREATE_SUCCESS created, $CREATE_FAILED failed)" | logger -s -t "par2cron-cron"
        [ "$ERRORNOTIFY" == "enable" ] && "$NOTIFY_BIN" -e "${EVENT}" -s "Alert ${SUBJECT} Create: Unclassified Error" -d "An unclassified error was returned ($CREATE_STARTED started, $CREATE_SUCCESS created, $CREATE_FAILED failed)." -i "alert"
        ;;
    *)
        echo "create: finished (return code: $RET - unexpected return code) ($CREATE_STARTED started, $CREATE_SUCCESS created, $CREATE_FAILED failed)" | logger -s -t "par2cron-cron"
        [ "$ERRORNOTIFY" == "enable" ] && "$NOTIFY_BIN" -e "${EVENT}" -s "Alert ${SUBJECT} Create: Unexpected Code" -d "An unexpected exit code was returned ($CREATE_STARTED started, $CREATE_SUCCESS created, $CREATE_FAILED failed)." -i "alert"
        ;;
    esac
fi

sleep 5

if [ "$CRONVERIFY" == "enable" ]; then
    echo "verify: started" | logger -s -t "par2cron-cron"

    if [ "$STARTNOTIFY" == "enable" ]; then
        "$NOTIFY_BIN" -e "${EVENT}" -s "Notice ${SUBJECT} Verify: Started" -d "Verification has started according to schedule." -i "warning"
    fi

    /usr/bin/par2cron verify \
        -c /boot/config/plugins/dwpar2cron/config.yaml \
        --json \
        "${OPSCOPE_ARRAY[@]}" \
        >> /var/log/dwpar2cron.log \
        2> >(tee -a /var/log/dwpar2cron.json >> /var/log/dwpar2cron.log 2>&1)
    RET=$?

    sleep 3
    sync

    TOTAL_STARTED=$(grep -c '"msg":"Job started"' /var/log/dwpar2cron.json 2>/dev/null)
    TOTAL_SUCCESS=$(grep -c '"msg":"Job completed with success"' /var/log/dwpar2cron.json 2>/dev/null)
    TOTAL_FAILED=$(grep -c '"msg":"Job failure (will retry next run)"' /var/log/dwpar2cron.json 2>/dev/null)

    VERIFY_STARTED=$((TOTAL_STARTED - CREATE_STARTED))
    VERIFY_SUCCESS=$((TOTAL_SUCCESS - CREATE_SUCCESS))
    VERIFY_FAILED=$((TOTAL_FAILED - CREATE_FAILED))
    VERIFY_CORRUPTED=$(grep -c '"msg":"Job completed with corruption detected"' /var/log/dwpar2cron.json 2>/dev/null)

    case "$RET" in
    0)
        echo "verify: finished (return code: $RET - success) ($VERIFY_STARTED started, $VERIFY_SUCCESS ok, $VERIFY_CORRUPTED corrupted, $VERIFY_FAILED failed)" | logger -s -t "par2cron-cron"
        if [ "$VERIFY_STARTED" -gt 0 ] || [ "$ZERONOTIFY" == "enable" ]; then
            [ "$SUCCESSNOTIFY" == "enable" ] && "$NOTIFY_BIN" -e "${EVENT}" -s "Notice ${SUBJECT} Verify: Success" -d "Verification has finished with success ($VERIFY_STARTED started, $VERIFY_SUCCESS ok, $VERIFY_CORRUPTED corrupted, $VERIFY_FAILED failed)." -i "normal"
        fi
        ;;
    1)
        echo "verify: finished (return code: $RET - partial failure) ($VERIFY_STARTED started, $VERIFY_SUCCESS ok, $VERIFY_CORRUPTED corrupted, $VERIFY_FAILED failed)" | logger -s -t "par2cron-cron"
        [ "$ERRORNOTIFY" == "enable" ] && "$NOTIFY_BIN" -e "${EVENT}" -s "Alert ${SUBJECT} Verify: Partial Failure" -d "Not all jobs could be verified ($VERIFY_STARTED started, $VERIFY_SUCCESS ok, $VERIFY_CORRUPTED corrupted, $VERIFY_FAILED failed)." -i "alert"
        ;;
    2)
        echo "verify: finished (return code: $RET - bad invocation) ($VERIFY_STARTED started, $VERIFY_SUCCESS ok, $VERIFY_CORRUPTED corrupted, $VERIFY_FAILED failed)" | logger -s -t "par2cron-cron"
        [ "$ERRORNOTIFY" == "enable" ] && "$NOTIFY_BIN" -e "${EVENT}" -s "Alert ${SUBJECT} Verify: Bad Invocation" -d "A bad invocation error was returned ($VERIFY_STARTED started, $VERIFY_SUCCESS ok, $VERIFY_CORRUPTED corrupted, $VERIFY_FAILED failed)." -i "alert"
        ;;
    3)
        echo "verify: finished (return code: $RET - repairable corruption) ($VERIFY_STARTED started, $VERIFY_SUCCESS ok, $VERIFY_CORRUPTED corrupted, $VERIFY_FAILED failed)" | logger -s -t "par2cron-cron"
        [ "$ERRORNOTIFY" == "enable" ] && "$NOTIFY_BIN" -e "${EVENT}" -s "Alert ${SUBJECT} Verify: Repairable Corruption" -d "Verification has detected repairable corruption ($VERIFY_STARTED started, $VERIFY_SUCCESS ok, $VERIFY_CORRUPTED corrupted, $VERIFY_FAILED failed)." -i "alert"
        ;;
    4)
        echo "verify: finished (return code: $RET - unrepairable corruption) ($VERIFY_STARTED started, $VERIFY_SUCCESS ok, $VERIFY_CORRUPTED corrupted, $VERIFY_FAILED failed)" | logger -s -t "par2cron-cron"
        [ "$ERRORNOTIFY" == "enable" ] && "$NOTIFY_BIN" -e "${EVENT}" -s "Alert ${SUBJECT} Verify: Unrepairable Corruption" -d "Verification has detected unrepairable corruption ($VERIFY_STARTED started, $VERIFY_SUCCESS ok, $VERIFY_CORRUPTED corrupted, $VERIFY_FAILED failed)." -i "alert"
        ;;
    5)
        echo "verify: finished (return code: $RET - unclassified error) ($VERIFY_STARTED started, $VERIFY_SUCCESS ok, $VERIFY_CORRUPTED corrupted, $VERIFY_FAILED failed)" | logger -s -t "par2cron-cron"
        [ "$ERRORNOTIFY" == "enable" ] && "$NOTIFY_BIN" -e "${EVENT}" -s "Alert ${SUBJECT} Verify: Unclassified Error" -d "An unclassified error was returned ($VERIFY_STARTED started, $VERIFY_SUCCESS ok, $VERIFY_CORRUPTED corrupted, $VERIFY_FAILED failed)." -i "alert"
        ;;
    *)
        echo "verify: finished (return code: $RET - unexpected return code) ($VERIFY_STARTED started, $VERIFY_SUCCESS ok, $VERIFY_CORRUPTED corrupted, $VERIFY_FAILED failed)" | logger -s -t "par2cron-cron"
        [ "$ERRORNOTIFY" == "enable" ] && "$NOTIFY_BIN" -e "${EVENT}" -s "Alert ${SUBJECT} Verify: Unexpected Code" -d "An unexpected exit code was returned ($VERIFY_STARTED started, $VERIFY_SUCCESS ok, $VERIFY_CORRUPTED corrupted, $VERIFY_FAILED failed)." -i "alert"
        ;;
    esac
fi

sleep 5

if [ "$CRONREPAIR" == "enable" ]; then
    echo "repair: started" | logger -s -t "par2cron-cron"

    if [ "$STARTNOTIFY" == "enable" ]; then
        "$NOTIFY_BIN" -e "${EVENT}" -s "Notice ${SUBJECT} Repair: Started" -d "Repairing has started according to schedule." -i "warning"
    fi

    /usr/bin/par2cron repair \
        -c /boot/config/plugins/dwpar2cron/config.yaml \
        --json \
        "${OPSCOPE_ARRAY[@]}" \
        >> /var/log/dwpar2cron.log \
        2> >(tee -a /var/log/dwpar2cron.json >> /var/log/dwpar2cron.log 2>&1)
    RET=$?

    sleep 3
    sync

    TOTAL_STARTED=$(grep -c '"msg":"Job started"' /var/log/dwpar2cron.json 2>/dev/null)
    TOTAL_SUCCESS=$(grep -c '"msg":"Job completed with success"' /var/log/dwpar2cron.json 2>/dev/null)
    TOTAL_FAILED=$(grep -c '"msg":"Job failure (will retry next run)"' /var/log/dwpar2cron.json 2>/dev/null)

    REPAIR_STARTED=$((TOTAL_STARTED - CREATE_STARTED - VERIFY_STARTED))
    REPAIR_SUCCESS=$((TOTAL_SUCCESS - CREATE_SUCCESS - VERIFY_SUCCESS))
    REPAIR_FAILED=$((TOTAL_FAILED - CREATE_FAILED - VERIFY_FAILED))

    case "$RET" in
    0)
        echo "repair: finished (return code: $RET - success) ($REPAIR_STARTED started, $REPAIR_SUCCESS repaired, $REPAIR_FAILED failed)" | logger -s -t "par2cron-cron"
        if [ "$REPAIR_STARTED" -gt 0 ] || [ "$ZERONOTIFY" == "enable" ]; then
            [[ "$SUCCESSNOTIFY" == "enable" || "$REPAIRNOTIFY" == "enable" ]] && "$NOTIFY_BIN" -e "${EVENT}" -s "Notice ${SUBJECT} Repair: Success" -d "Repairing has finished with success ($REPAIR_STARTED started, $REPAIR_SUCCESS repaired, $REPAIR_FAILED failed)." -i "normal"
        fi
        ;;
    1)
        echo "repair: finished (return code: $RET - partial failure) ($REPAIR_STARTED started, $REPAIR_SUCCESS repaired, $REPAIR_FAILED failed)" | logger -s -t "par2cron-cron"
        [[ "$ERRORNOTIFY" == "enable" || "$REPAIRNOTIFY" == "enable" ]] && "$NOTIFY_BIN" -e "${EVENT}" -s "Alert ${SUBJECT} Repair: Partial Failure" -d "Not all jobs could be repaired ($REPAIR_STARTED started, $REPAIR_SUCCESS repaired, $REPAIR_FAILED failed)." -i "alert"
        ;;
    2)
        echo "repair: finished (return code: $RET - bad invocation) ($REPAIR_STARTED started, $REPAIR_SUCCESS repaired, $REPAIR_FAILED failed)" | logger -s -t "par2cron-cron"
        [[ "$ERRORNOTIFY" == "enable" || "$REPAIRNOTIFY" == "enable" ]] && "$NOTIFY_BIN" -e "${EVENT}" -s "Alert ${SUBJECT} Repair: Bad Invocation" -d "A bad invocation error was returned ($REPAIR_STARTED started, $REPAIR_SUCCESS repaired, $REPAIR_FAILED failed)." -i "alert"
        ;;
    5)
        echo "repair: finished (return code: $RET - unclassified error) ($REPAIR_STARTED started, $REPAIR_SUCCESS repaired, $REPAIR_FAILED failed)" | logger -s -t "par2cron-cron"
        [[ "$ERRORNOTIFY" == "enable" || "$REPAIRNOTIFY" == "enable" ]] && "$NOTIFY_BIN" -e "${EVENT}" -s "Alert ${SUBJECT} Repair: Unclassified Error" -d "An unclassified error was returned ($REPAIR_STARTED started, $REPAIR_SUCCESS repaired, $REPAIR_FAILED failed)." -i "alert"
        ;;
    *)
        echo "repair: finished (return code: $RET - unexpected return code) ($REPAIR_STARTED started, $REPAIR_SUCCESS repaired, $REPAIR_FAILED failed)" | logger -s -t "par2cron-cron"
        [[ "$ERRORNOTIFY" == "enable" || "$REPAIRNOTIFY" == "enable" ]] && "$NOTIFY_BIN" -e "${EVENT}" -s "Alert ${SUBJECT} Repair: Unexpected Code" -d "An unexpected exit code was returned ($REPAIR_STARTED started, $REPAIR_SUCCESS repaired, $REPAIR_FAILED failed)." -i "alert"
        ;;
    esac
fi

sleep 5

echo "info: started" | logger -s -t "par2cron-cron"

/usr/bin/par2cron info \
    -c /boot/config/plugins/dwpar2cron/config.yaml \
    --json \
    "${OPSCOPE_ARRAY[@]}" \
    > /usr/local/emhttp/plugins/dwpar2cron/info.json \
    2> >(tee -a /var/log/dwpar2cron.json >> /var/log/dwpar2cron.log 2>&1)
RET=$?

case "$RET" in
0)
    echo "info: finished (return code: $RET - success)" | logger -s -t "par2cron-cron"
    ;;
1)
    echo "info: finished (return code: $RET - partial failure)" | logger -s -t "par2cron-cron"
    ;;
2)
    echo "info: finished (return code: $RET - bad invocation)" | logger -s -t "par2cron-cron"
    ;;
5)
    echo "info: finished (return code: $RET - unclassified error)" | logger -s -t "par2cron-cron"
    ;;
*)
    echo "info: finished (return code: $RET - unexpected return code)" | logger -s -t "par2cron-cron"
    ;;
esac

sync
exit 0
