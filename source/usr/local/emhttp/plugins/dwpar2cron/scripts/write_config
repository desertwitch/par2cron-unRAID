DOCROOT="/usr/local/emhttp/plugins/dwpar2cron"
source "/boot/config/plugins/dwpar2cron/dwpar2cron.cfg" || exit 2

echo "Writing par2cron configuration..."
echo "Writing par2cron configuration..." | logger -t "par2cron-plugin"

rm -f "/boot/config/plugins/dynamix/dwpar2cron.cron"

if [ "$CRON" == "hourly" ]; then
    cp -f $DOCROOT/defaults/default.cron "/boot/config/plugins/dynamix/dwpar2cron.cron"
    sed -i '/par2cron-cron/s,^\*,0,' "/boot/config/plugins/dynamix/dwpar2cron.cron"
elif [ "$CRON" == "daily" ]; then
    cp -f $DOCROOT/defaults/default.cron "/boot/config/plugins/dynamix/dwpar2cron.cron"
    sed -i "/par2cron-cron/s,^\* \*,0 ${CRONHOUR}," "/boot/config/plugins/dynamix/dwpar2cron.cron"
elif [ "$CRON" == "weekly" ]; then
    cp -f $DOCROOT/defaults/default.cron "/boot/config/plugins/dynamix/dwpar2cron.cron"
    sed -i "/par2cron-cron/s,^\* \* \* \* \*,0 ${CRONHOUR} \* \* ${CRONDOW}," "/boot/config/plugins/dynamix/dwpar2cron.cron"
elif [ "$CRON" == "monthly" ]; then
    cp -f $DOCROOT/defaults/default.cron "/boot/config/plugins/dynamix/dwpar2cron.cron"
    sed -i "/par2cron-cron/s,^\* \* \*,0 ${CRONHOUR} ${CRONDOM}," "/boot/config/plugins/dynamix/dwpar2cron.cron"
else
    rm -f "/boot/config/plugins/dynamix/dwpar2cron.cron"
fi

sleep 1
update_cron
sleep 1

set_cpu_limit() {
    local dir="$1"
    local pct="$2"
    local cores
    cores=$(nproc 2>/dev/null || echo 1)
    local period=100000
    [ ! -d "$dir" ] && mkdir -p "$dir"
    if [ -n "$pct" ] && [ "$pct" -gt 0 ] 2>/dev/null; then
        local quota=$(( pct * period * cores / 100 ))
        echo "$quota $period" > "$dir/cpu.max" 2>&1 || echo "ERROR: failed to set cpu.max in $dir" | logger -t "par2cron-plugin"
    else
        echo "max $period" > "$dir/cpu.max" 2>&1 || echo "ERROR: failed to set cpu.max in $dir" | logger -t "par2cron-plugin"
    fi
}

if grep -q cgroup2 /proc/mounts; then
    {
        echo "+cpu" > /sys/fs/cgroup/cgroup.subtree_control 2>&1
        echo "  root +cpu exit: $?"
        echo "  root subtree_control: $(cat /sys/fs/cgroup/cgroup.subtree_control)"

        mkdir -p /sys/fs/cgroup/par2
        echo "  par2 cgroup.controllers: $(cat /sys/fs/cgroup/par2/cgroup.controllers)"
        echo "  par2 cgroup.procs: $(cat /sys/fs/cgroup/par2/cgroup.procs)"

        echo "+cpu" > /sys/fs/cgroup/par2/cgroup.subtree_control 2>&1
        echo "  par2 +cpu exit: $?"
        echo "  par2 subtree_control: $(cat /sys/fs/cgroup/par2/cgroup.subtree_control)"

        mkdir -p /sys/fs/cgroup/par2/create
        mkdir -p /sys/fs/cgroup/par2/verify
        mkdir -p /sys/fs/cgroup/par2/repair
        echo "  create cgroup.controllers: $(cat /sys/fs/cgroup/par2/create/cgroup.controllers)"
        echo "  verify cgroup.controllers: $(cat /sys/fs/cgroup/par2/verify/cgroup.controllers)"
        echo "  repair cgroup.controllers: $(cat /sys/fs/cgroup/par2/repair/cgroup.controllers)"

        echo "  create cpu.max exists: $([ -f /sys/fs/cgroup/par2/create/cpu.max ] && echo yes || echo no)"
        echo "  verify cpu.max exists: $([ -f /sys/fs/cgroup/par2/verify/cpu.max ] && echo yes || echo no)"
        echo "  repair cpu.max exists: $([ -f /sys/fs/cgroup/par2/repair/cpu.max ] && echo yes || echo no)"

        set_cpu_limit "/sys/fs/cgroup/par2/create" "$CREATECPU"
        set_cpu_limit "/sys/fs/cgroup/par2/verify" "$VERIFYCPU"
        set_cpu_limit "/sys/fs/cgroup/par2/repair" "$REPAIRCPU"

        echo "  create cpu.max: $(cat /sys/fs/cgroup/par2/create/cpu.max 2>&1)"
        echo "  verify cpu.max: $(cat /sys/fs/cgroup/par2/verify/cpu.max 2>&1)"
        echo "  repair cpu.max: $(cat /sys/fs/cgroup/par2/repair/cpu.max 2>&1)"
    } 2>&1 | logger -t "par2cron-plugin"
else
    echo "WARNING: CPU limits not available (no cgroup v2 mount)" | logger -t "par2cron-plugin"
fi

sleep 1
