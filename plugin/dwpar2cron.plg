- release note: please report any problems in the support topic.
</CHANGES>

<FILE Run="/bin/bash">
<INLINE>
for pkg in &plgPATH;/par2cmdline-*; do
    if [[ -f "$pkg" ]]; then
        if [[ "$(basename "$pkg")" == par2cmdline-turbo* ]]; then
            removepkg "$pkg"
            rm -f "$pkg"
        fi
    fi
done
if compgen -G "&plgPATH;/custom/*" 1>/dev/null 2>/dev/null; then
    # If a custom backend is present now, clean any default backends first.
    if compgen -G "&plgPATH;/par2cmdline-*" 1>/dev/null 2>/dev/null; then
        removepkg &plgPATH;/par2cmdline-*
    fi
    # We always reinstall custom backends to avoid broken states...
    if compgen -G "/tmp/par2cron-custom/*.txz" 1>/dev/null 2>/dev/null; then
        removepkg /tmp/par2cron-custom/*.txz
    fi
    if [[ -f /tmp/par2cron-custom/par2 ]]; then
        rm -f /usr/bin/par2
    fi
    rm -rf /tmp/par2cron-custom
elif compgen -G "/tmp/par2cron-custom/*" 1>/dev/null 2>/dev/null; then
    # If a custom backend was present but is no longer, clean any custom backends first.
    if compgen -G "/tmp/par2cron-custom/*.txz" 1>/dev/null 2>/dev/null; then
        removepkg /tmp/par2cron-custom/*.txz
    fi
    if [[ -f /tmp/par2cron-custom/par2 ]]; then
        rm -f /usr/bin/par2
    fi
    rm -rf /tmp/par2cron-custom
fi
exit 0
</INLINE>
</FILE>

<FILE Name="&plgPATH;/par2cmdline-1.1.1-x86_64-4.txz" Min="6.10">
<URL>&pkgURL;/par2cmdline-1.1.1-x86_64-4.txz</URL>
<MD5>5a3bd70a7e5de437ba45d4483ad99ff4</MD5>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
echo ""
if compgen -G "&plgPATH;/custom/*.txz" 1>/dev/null 2>/dev/null; then
    mkdir -p /tmp/par2cron-custom
    echo "A par2 backend was provided by the user, installing that instead..."
    echo "You can remove the &plgPATH;/custom/ folder to install the default one."
    upgradepkg --install-new &plgPATH;/custom/*.txz
    cp -f &plgPATH;/custom/*.txz /tmp/par2cron-custom/
    if [[ -f &plgPATH;/custom/par2 ]]; then
        cp -f &plgPATH;/custom/par2 /usr/bin/par2
        cp -f &plgPATH;/custom/par2 /tmp/par2cron-custom/
        chmod 755 /usr/bin/par2
    fi
elif [[ -f &plgPATH;/custom/par2 ]]; then
    mkdir -p /tmp/par2cron-custom
    echo "A par2 backend was provided by the user, installing that instead..."
    echo "You can remove the &plgPATH;/custom/ folder to install the default one."
    cp -f &plgPATH;/custom/par2 /usr/bin/par2
    cp -f &plgPATH;/custom/par2 /tmp/par2cron-custom/
    chmod 755 /usr/bin/par2
else
    rm -rf /tmp/par2cron-custom
    echo "No par2 backend was provided by the user, installing the default..."
    echo "You can provide a custom par2 binary or .txz in: &plgPATH;/custom/"
    upgradepkg --install-new &plgPATH;/par2cmdline-1.1.1-x86_64-4.txz
fi
echo ""
exit 0
</INLINE>
</FILE>

<FILE Name="&plgPATH;/par2cron-0.7.0-x86_64-1.txz" Min="6.10" Run="upgradepkg --install-new">
<URL>&pkgURL;/par2cron-0.7.0-x86_64-1.txz</URL>
<MD5>1a78d8407153a663f5d89494fdb8e141</MD5>
</FILE>

<FILE Name="&plgPATH;/&plgNAME;.txz" Min="6.10" Run="upgradepkg --install-new">
<URL>&gitURL;/archive/&plgNAME;.txz</URL>
<MD5>&plgMD5;</MD5>
</FILE>

<!--
run the post-installation scripts
-->
<FILE Run="/bin/bash">
<INLINE>
echo ""

if [ -x /usr/local/emhttp/plugins/dwpar2cron/scripts/write_config ]; then
    /usr/local/emhttp/plugins/dwpar2cron/scripts/write_config
fi

echo ""
echo "-------------------------------------------------------------"
echo " par2cron for UNRAID has been installed."
echo " Version: &version; / Plugin Maintainer: &author;"
echo "-------------------------------------------------------------"
echo ""
</INLINE>
</FILE>

<!--
definition for uninstallation of the plugin
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
killall par2cron >/dev/null 2>&amp;1

removepkg &plgPATH;/*.txz

if compgen -G "&plgPATH;/custom/*" 1>/dev/null 2>/dev/null; then
    # The user has a custom backend, uninstall it but preserve it on USB.
    if compgen -G "&plgPATH;/custom/*.txz" 1>/dev/null 2>/dev/null; then
        removepkg &plgPATH;/custom/*.txz
    fi
    if [[ -f &plgPATH;/custom/par2 ]]; then
        rm -f /usr/bin/par2
    fi
    if [ -n "&plgPATH;" ]; then
        rm -f &plgPATH;/*
    fi
elif compgen -G "/tmp/par2cron-custom/*" 1>/dev/null 2>/dev/null; then
    # The user removed their custom backend, ensure it is also uninstalled.
    if compgen -G "/tmp/par2cron-custom/*.txz" 1>/dev/null 2>/dev/null; then
        removepkg /tmp/par2cron-custom/*.txz
    fi
    if [[ -f /tmp/par2cron-custom/par2 ]]; then
        rm -f /usr/bin/par2
    fi
    rm -rf &plgPATH;
else
    rm -rf &plgPATH;
fi

rm -rf &emhttp;
rm -rf /tmp/par2cron-custom
rm -rf /var/log/dwpar2cron

rm -rf /mnt/user/system/par2cron
rm -rf /dev/shm/par2cron
rm -rf /tmp/par2cron

rm -f /boot/config/plugins/dynamix/dwpar2cron.cron
rm -f /tmp/par2cron-pprof-*.pb.gz

sleep 1
update_cron
sleep 1

echo ""
echo "-----------------------------------------------------------"
echo " par2cron for UNRAID has been removed."
echo " Version: &version; / Plugin Maintainer: &author;"
echo "-----------------------------------------------------------"
echo ""
</INLINE>
</FILE>

</PLUGIN>
