<?xml version='1.0' standalone='yes'?>

<!DOCTYPE PLUGIN [
<!ENTITY name      "dwpar2cron">
<!ENTITY author    "desertwitch">
<!ENTITY version   "2026.04.07d">
<!ENTITY launch    "Settings/dwpar2cron">
<!ENTITY gitURL    "https://raw.githubusercontent.com/&author;/par2cron-unRAID/main">
<!ENTITY pluginURL "&gitURL;/plugin/&name;.plg">
<!ENTITY pkgURL    "&gitURL;/packages">
<!ENTITY plgPATH   "/boot/config/plugins/&name;">
<!ENTITY plgNAME   "dwpar2cron-2026.04.07-x86_64-4">
<!ENTITY plgMD5    "d545384a83fb1389dcfc322f11acef72">
<!ENTITY emhttp    "/usr/local/emhttp/plugins/&name;">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" support="https://forums.unraid.net/topic/196782-plugin-par2cron-for-unraid/" min="6.10">

<CHANGES>
## par2cron for UNRAID
###2026.04.10
- new: allow selection of shares to run par2cron against
- new: allow generation of diagnostic performance profiles
- new: added creation mode nested for growing media libraries
- new: added marker config option to allow persisting marker files
- fix: filesystem scanning performance significantly improved
- new: par2cron backend was updated to release version 0.3.0
- changes: https://github.com/desertwitch/par2cron/releases/tag/v0.3.0
- release note: thanks to forum user Karools for their feedback and testing
###2026.04.07d
- new: par2cron backend was updated to release version 0.2.2 (bugfix)
- changes: https://github.com/desertwitch/par2cron/releases/tag/v0.2.2
###2026.04.07
- new: par2cron backend was updated to release version 0.2.0
- changes: https://github.com/desertwitch/par2cron/releases/tag/v0.2.0
###2026.02.07
- new: par2cmdline backend was updated to release version 1.1.1
- changes: https://github.com/Parchive/par2cmdline/releases/tag/v1.1.1
###2026.02.03
- new: quick guide was updated to include new recursive mode
- new: par2cron backend was updated to release version 0.1.6
- changes: https://github.com/desertwitch/par2cron/releases/tag/v0.1.6
###2026.01.31
- new: par2cron backend was updated to release version 0.1.5
- changes: https://github.com/desertwitch/par2cron/releases/tag/v0.1.5
###2026.01.28
- new: par2cron backend was updated to release version 0.1.4
- new: quick guide was updated with more information about creation
###2026.01.27b
- new: par2cmdline backend was updated to release version 1.1.0
- fix: invisible guide colors in dark mode (thanks to Synd for the report)
###2026.01.27
- new: par2cron backend was updated to release version 0.1.3
###2026.01.26b
- release note: welcome to the first version of the par2cron package.
- release note: please report any problems in the support topic.
</CHANGES>

<FILE Name="&plgPATH;/par2cmdline-1.1.1-x86_64-1.txz" Min="6.10" Run="upgradepkg --install-new">
<URL>&pkgURL;/par2cmdline-1.1.1-x86_64-1.txz</URL>
<MD5>b824535f9d1a692817c7726996545033</MD5>
</FILE>

<FILE Name="&plgPATH;/par2cron-0.3.0-x86_64-1.txz" Min="6.10" Run="upgradepkg --install-new">
<URL>&pkgURL;/par2cron-0.3.0-x86_64-1.txz</URL>
<MD5>4cf1a9031d47229389b5b61f73a24702</MD5>
</FILE>

<FILE Name="&plgPATH;/&plgNAME;.txz" Min="6.10" Run="upgradepkg --install-new">
<URL>&gitURL;/archive/&plgNAME;.txz</URL>
<MD5>&plgMD5;</MD5>
</FILE>

<!--
run the post-installation scripts
-->
<FILE Run="/bin/bash">
<INLINE>
echo ""

if [ -x /usr/local/emhttp/plugins/dwpar2cron/scripts/write_config ]; then
    /usr/local/emhttp/plugins/dwpar2cron/scripts/write_config
fi

echo ""
echo "-------------------------------------------------------------"
echo " par2cron for UNRAID has been installed."
echo " Version: &version; / Plugin Maintainer: &author;"
echo "-------------------------------------------------------------"
echo ""
</INLINE>
</FILE>

<!--
definition for uninstallation of the plugin
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
killall par2cron >/dev/null 2>&amp;1

removepkg &plgPATH;/*.txz

rm -rf &plgPATH;
rm -rf &emhttp;

rm -f /var/log/dwpar2cron.json
rm -f /var/log/dwpar2cron.log
rm -f /boot/config/plugins/dynamix/dwpar2cron.cron
rm -f /tmp/par2cron-pprof-*.pb.gz

sleep 1
update_cron
sleep 1

echo ""
echo "-----------------------------------------------------------"
echo " par2cron for UNRAID has been removed."
echo " Version: &version; / Plugin Maintainer: &author;"
echo "-----------------------------------------------------------"
echo ""
</INLINE>
</FILE>

</PLUGIN>
